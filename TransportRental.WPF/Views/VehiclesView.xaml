<UserControl x:Class="TransportRental.WPF.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Width="250" Padding="5" FontSize="13"
                     TextChanged="Search_TextChanged"/>
            <ComboBox x:Name="CategoryFilter" Width="180" Margin="10,0,0,0" Padding="5"
                      FontSize="13" SelectionChanged="CategoryFilter_Changed" DisplayMemberPath="Name"/>
            <CheckBox x:Name="AvailableOnly" Content="Только доступные" Margin="10,5,0,0"
                      FontSize="13" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Margin="20,0,0,0"
                    Click="Add_Click" x:Name="AddButton"/>
            <Button Content="Изменить" Padding="15,8" Margin="5,0,0,0"
                    Click="Edit_Click" x:Name="EditButton"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}" Margin="5,0,0,0"
                    Click="Delete_Click" x:Name="DeleteButton"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid x:Name="VehiclesGrid" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="130"/>
                <DataGridTextColumn Header="Гос. номер" Binding="{Binding LicensePlate}" Width="100"/>
                <DataGridTextColumn Header="Тариф/час" Binding="{Binding HourlyRate, StringFormat='{}{0:N0} руб.'}" Width="100"/>
                <DataGridTextColumn Header="Тариф/день" Binding="{Binding DailyRate, StringFormat='{}{0:N0} руб.'}" Width="100"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="60"/>
                <DataGridCheckBoxColumn Header="Доступен" Binding="{Binding IsAvailable}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
