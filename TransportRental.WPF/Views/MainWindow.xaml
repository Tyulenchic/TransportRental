<Window x:Class="TransportRental.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TransportRental.WPF.Views"
        Title="Прокат транспорта" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <TextBlock x:Name="StatusText" Text="Готово"/>
            <Separator/>
            <TextBlock x:Name="UserText"/>
        </StatusBar>

        <TabControl x:Name="MainTabs" Margin="5">
            <TabItem Header="Транспорт" x:Name="VehiclesTab">
                <views:VehiclesView/>
            </TabItem>
            <TabItem Header="Клиенты" x:Name="CustomersTab">
                <views:CustomersView/>
            </TabItem>
            <TabItem Header="Прокаты" x:Name="RentalsTab">
                <views:RentalsView/>
            </TabItem>
            <TabItem Header="Отчёты" x:Name="ReportsTab">
                <views:ReportsView/>
            </TabItem>
            <TabItem Header="Пользователи" x:Name="UsersTab">
                <views:UsersView/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
