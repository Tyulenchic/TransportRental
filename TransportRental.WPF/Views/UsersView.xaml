<UserControl x:Class="TransportRental.WPF.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить пользователя" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
            <Button Content="Изменить" Padding="15,8" Margin="5,0,0,0" Click="Edit_Click"/>
            <Button Content="Деактивировать" Style="{StaticResource DangerButton}" Margin="5,0,0,0" Click="Deactivate_Click"/>
        </StackPanel>

        <DataGrid x:Name="UsersGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="130"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="130"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
