<Window x:Class="TransportRental.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прокат транспорта - Вход" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Прокат транспорта" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Foreground="#2196F3"/>

        <TextBlock Grid.Row="2" Text="Логин:" FontSize="14"/>
        <TextBox Grid.Row="4" x:Name="UsernameBox" FontSize="14" Padding="5"/>

        <TextBlock Grid.Row="6" Text="Пароль:" FontSize="14"/>
        <PasswordBox Grid.Row="8" x:Name="PasswordBox" FontSize="14" Padding="5"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Войти" Style="{StaticResource PrimaryButton}"
                    Click="Login_Click" Width="120" Margin="0,0,10,0"/>
        </StackPanel>
    </Grid>
</Window>
