<Window x:Class="TransportRental.WPF.Views.Dialogs.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Height="320" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Логин:*" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="UsernameBox" Padding="5"/>

        <TextBlock Grid.Row="2" Text="ФИО:*" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="FullNameBox" Padding="5"/>

        <TextBlock Grid.Row="4" Text="Пароль:" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" Padding="5"/>

        <TextBlock Grid.Row="6" Text="Роль:*" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="RoleBox" Padding="5" DisplayMemberPath="Name"/>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="100"/>
            <Button Content="Отмена" Padding="15,8" Margin="10,0,0,0" Click="Cancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
