<Window x:Class="TransportRental.WPF.Views.Dialogs.CustomerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент" Height="420" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Фамилия:*" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="LastNameBox" Padding="5"/>

        <TextBlock Grid.Row="2" Text="Имя:*" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="FirstNameBox" Padding="5"/>

        <TextBlock Grid.Row="4" Text="Отчество:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="MiddleNameBox" Padding="5"/>

        <TextBlock Grid.Row="6" Text="Телефон:*" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="PhoneBox" Padding="5"/>

        <TextBlock Grid.Row="8" Text="Email:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="EmailBox" Padding="5"/>

        <TextBlock Grid.Row="10" Text="Паспорт:*" VerticalAlignment="Center"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="PassportBox" Padding="5"/>

        <TextBlock Grid.Row="12" Text="Адрес:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="12" Grid.Column="1" x:Name="AddressBox" Padding="5"/>

        <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="100"/>
            <Button Content="Отмена" Padding="15,8" Margin="10,0,0,0" Click="Cancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
