<Window x:Class="TransportRental.WPF.Views.Dialogs.VehicleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Транспорт" Height="450" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Название:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Padding="5"/>

        <TextBlock Grid.Row="2" Text="Категория:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CategoryBox" DisplayMemberPath="Name" Padding="5"/>

        <TextBlock Grid.Row="4" Text="Гос. номер:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="LicensePlateBox" Padding="5"/>

        <TextBlock Grid.Row="6" Text="Тариф/час (руб.):" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="HourlyRateBox" Padding="5"/>

        <TextBlock Grid.Row="8" Text="Тариф/день (руб.):" VerticalAlignment="Center"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="DailyRateBox" Padding="5"/>

        <TextBlock Grid.Row="10" Text="Год выпуска:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="YearBox" Padding="5"/>

        <TextBlock Grid.Row="12" Text="Описание:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="12" Grid.Column="1" x:Name="DescriptionBox" Padding="5" Height="50"
                 TextWrapping="Wrap" AcceptsReturn="True"/>

        <CheckBox Grid.Row="14" Grid.Column="1" x:Name="IsAvailableBox" Content="Доступен" IsChecked="True"/>

        <StackPanel Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="100"/>
            <Button Content="Отмена" Padding="15,8" Margin="10,0,0,0" Click="Cancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
