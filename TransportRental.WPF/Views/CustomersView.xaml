<UserControl x:Class="TransportRental.WPF.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Width="300" Padding="5" FontSize="13"
                     TextChanged="Search_TextChanged"/>
            <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Margin="20,0,0,0" Click="Add_Click"/>
            <Button Content="Изменить" Padding="15,8" Margin="5,0,0,0" Click="Edit_Click"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}" Margin="5,0,0,0" Click="Delete_Click"/>
        </StackPanel>

        <DataGrid x:Name="CustomersGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="130"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="130"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="130"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
                <DataGridTextColumn Header="Паспорт" Binding="{Binding PassportNumber}" Width="120"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
