<UserControl x:Class="TransportRental.WPF.Views.RentalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="StatusFilter" Width="160" Padding="5" FontSize="13"
                      SelectionChanged="StatusFilter_Changed">
                <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                <ComboBoxItem Content="Активные" Tag="Active"/>
                <ComboBoxItem Content="Просроченные" Tag="Overdue"/>
                <ComboBoxItem Content="Завершённые" Tag="Completed"/>
                <ComboBoxItem Content="Отменённые" Tag="Cancelled"/>
            </ComboBox>
            <TextBlock Text="С:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <DatePicker x:Name="DateFrom" Width="130" SelectedDateChanged="DateFilter_Changed"/>
            <TextBlock Text="По:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <DatePicker x:Name="DateTo" Width="130" SelectedDateChanged="DateFilter_Changed"/>
            <Button Content="Новый прокат" Style="{StaticResource PrimaryButton}" Margin="20,0,0,0" Click="NewRental_Click"/>
            <Button Content="Возврат" Style="{StaticResource SuccessButton}" Margin="5,0,0,0" Click="Return_Click"/>
            <Button Content="Отменить" Style="{StaticResource DangerButton}" Margin="5,0,0,0" Click="Cancel_Click"/>
        </StackPanel>

        <DataGrid x:Name="RentalsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Транспорт" Binding="{Binding Vehicle.Name}" Width="180"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Customer.FullName}" Width="160"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="130"/>
                <DataGridTextColumn Header="Ожидаемый возврат" Binding="{Binding ExpectedEndDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                <DataGridTextColumn Header="Факт. возврат" Binding="{Binding EndDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="130"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat='{}{0:N0} руб.'}" Width="100"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding User.FullName}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
