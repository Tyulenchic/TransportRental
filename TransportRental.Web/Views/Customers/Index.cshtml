@model List<TransportRental.Core.Models.Customer>
@{
    ViewData["Title"] = "Клиенты";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Клиенты</h2>
    <a asp-action="Create" class="btn btn-primary">Добавить клиента</a>
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Поиск по ФИО, телефону..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary">Найти</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Сброс</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ФИО</th>
            <th>Телефон</th>
            <th>Email</th>
            <th>Паспорт</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.FullName</td>
                <td>@c.Phone</td>
                <td>@(c.Email ?? "---")</td>
                <td>@c.PassportNumber</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Изменить</a>
                    @if (User.IsInRole("Администратор") || User.IsInRole("Менеджер"))
                    {
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Удалить клиента?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Клиенты не найдены</div>
}
