@model List<TransportRental.Core.Models.User>
@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Пользователи системы</h2>
    <a asp-action="Create" class="btn btn-primary">Добавить пользователя</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Логин</th>
            <th>ФИО</th>
            <th>Роль</th>
            <th>Статус</th>
            <th>Дата создания</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr class="@(u.IsActive ? "" : "table-secondary")">
                <td>@u.Username</td>
                <td>@u.FullName</td>
                <td>@u.Role?.Name</td>
                <td>
                    @if (u.IsActive)
                    {
                        <span class="badge bg-success">Активен</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Неактивен</span>
                    }
                </td>
                <td>@u.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-warning">Изменить</a>
                    <form asp-action="Toggle" asp-route-id="@u.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        @if (u.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Деактивировать пользователя?');">Деактивировать</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success">Активировать</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
