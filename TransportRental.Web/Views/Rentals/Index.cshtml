@model List<TransportRental.Core.Models.Rental>
@using TransportRental.Core.Models
@{
    ViewData["Title"] = "Прокаты";
    var status = ViewBag.Status as RentalStatus?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Прокаты</h2>
    <a asp-action="Create" class="btn btn-primary">Оформить прокат</a>
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Статус</label>
        <select name="status" class="form-select">
            <option value="">Все</option>
            <option value="Active" selected="@(status == RentalStatus.Active)">Активный</option>
            <option value="Completed" selected="@(status == RentalStatus.Completed)">Завершён</option>
            <option value="Overdue" selected="@(status == RentalStatus.Overdue)">Просрочен</option>
            <option value="Cancelled" selected="@(status == RentalStatus.Cancelled)">Отменён</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Дата с</label>
        <input type="date" name="dateFrom" value="@dateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Дата по</label>
        <input type="date" name="dateTo" value="@dateTo?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary me-2">Найти</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Сброс</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Транспорт</th>
            <th>Клиент</th>
            <th>Начало</th>
            <th>Ожид. возврат</th>
            <th>Факт. возврат</th>
            <th>Сумма</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.Vehicle?.Name</td>
                <td>@r.Customer?.FullName</td>
                <td>@r.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@r.ExpectedEndDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@(r.EndDate?.ToString("dd.MM.yyyy HH:mm") ?? "---")</td>
                <td>@(r.TotalPrice?.ToString("N0") ?? "---") &#8381;</td>
                <td>
                    @switch (r.Status)
                    {
                        case RentalStatus.Active:
                            <span class="badge bg-primary">Активный</span>
                            break;
                        case RentalStatus.Completed:
                            <span class="badge bg-success">Завершён</span>
                            break;
                        case RentalStatus.Overdue:
                            <span class="badge bg-danger">Просрочен</span>
                            break;
                        case RentalStatus.Cancelled:
                            <span class="badge bg-secondary">Отменён</span>
                            break;
                    }
                </td>
                <td>
                    @if (r.Status == RentalStatus.Active || r.Status == RentalStatus.Overdue)
                    {
                        <a asp-action="Return" asp-route-id="@r.Id" class="btn btn-sm btn-success">Вернуть</a>
                        <form asp-action="Cancel" asp-route-id="@r.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Отменить прокат?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Отмена</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Прокаты не найдены</div>
}
