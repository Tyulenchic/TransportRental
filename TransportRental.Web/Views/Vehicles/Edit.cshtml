@model TransportRental.Core.Models.Vehicle
@{
    ViewData["Title"] = "Редактировать транспорт";
    var categories = ViewBag.Categories as List<TransportRental.Core.Models.VehicleCategory> ?? new();
}

<h2>Редактировать транспорт</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Название</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Категория</label>
                <select asp-for="CategoryId" class="form-select">
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="LicensePlate" class="form-label">Гос. номер</label>
                <input asp-for="LicensePlate" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Year" class="form-label">Год выпуска</label>
                <input asp-for="Year" type="number" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="HourlyRate" class="form-label">Тариф за час (&#8381;)</label>
                <input asp-for="HourlyRate" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="HourlyRate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DailyRate" class="form-label">Тариф за сутки (&#8381;)</label>
                <input asp-for="DailyRate" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="DailyRate" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsAvailable" class="form-check-input" />
                <label asp-for="IsAvailable" class="form-check-label">Доступен для проката</label>
            </div>

            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
